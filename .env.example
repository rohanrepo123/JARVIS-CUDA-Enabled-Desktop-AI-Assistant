# ── JARVIS Configuration ─────────────────────────────────────────────

# Ollama (Local LLM)
JARVIS_OLLAMA_URL=http://127.0.0.1:11434
JARVIS_OLLAMA_MODEL=llama3.2

# ElevenLabs (Text-to-Speech) — Get your key at https://elevenlabs.io
# Provider: kokoro (local, CUDA when available) or elevenlabs (cloud)
JARVIS_TTS_PROVIDER=kokoro
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Whisper (Speech-to-Text) — Runs locally
# Options: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=base
# Options: cpu, cuda (if you have NVIDIA GPU)
WHISPER_DEVICE=cpu
# Options: int8 (cpu), float16 (gpu)
WHISPER_COMPUTE_TYPE=int8

# Interaction Mode: text or voice
JARVIS_MODE=text

# Database (leave empty for default location)
JARVIS_DATABASE_PATH=

# Server
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
